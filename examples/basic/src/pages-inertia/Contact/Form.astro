---
import { definePage, errorFor } from "astro-inertia";
import Layout from "../../layouts/Layout.astro";

const { props, page } = definePage<"Contact/Form">(Astro);
const { errors, old } = props;
---

<Layout title={props.title} page={page}>
  <h1>{props.title}</h1>
  {props.flash?.success && <p role="status">{props.flash.success}</p>}
  {errorFor(errors, "form") && <p role="alert">{errorFor(errors, "form")}</p>}

  <form method="post" action="/contact" novalidate>
    <input type="hidden" name="_token" value={props.csrfToken} />
    <label>
      Name
      <input name="name" value={old.name ?? ""} aria-invalid={errors.name ? "true" : undefined} />
    </label>
    {errorFor(errors, "name") && (
      <p class="error" data-error="name">
        {errorFor(errors, "name")}
      </p>
    )}
    <label>
      Email
      <input name="email" type="email" value={old.email ?? ""} aria-invalid={errors.email ? "true" : undefined} />
    </label>
    {errorFor(errors, "email") && (
      <p class="error" data-error="email">
        {errorFor(errors, "email")}
      </p>
    )}
    <button type="submit">Send</button>
  </form>

  <h2>Messages</h2>
  <ul data-testid="messages">
    {props.messages.map((m) => (
      <li>
        {m.name} &lt;{m.email}&gt;
      </li>
    ))}
  </ul>
</Layout>

<style>
  .error {
    color: #b00020;
  }
  label {
    display: block;
    margin-top: 0.5rem;
  }
</style>
