---
import { ClientRouter } from "astro:transitions";
import type { Page } from "astro-inertia";
import type { SharedProps } from "../types";

interface Props {
  page: Page<SharedProps>;
}

const { page } = Astro.props;
const { site, navigation, title } = page.props;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.title}</title>
    <ClientRouter />
  </head>
  <body data-component={page.component}>
    <header>
      <a href={site.home} class="brand">
        {site.title}
      </a>
      <nav aria-label="Main">
        {navigation.map((item) => (
          <a href={item.link} aria-current={item.current ? "page" : undefined}>
            {item.title}
          </a>
        ))}
      </nav>
      <nav aria-label="Language">
        {site.languages.map((language) => (
          <a href={language.link} hreflang={language.code} aria-current={language.active ? "true" : undefined}>
            {language.code.toUpperCase()}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #ddd;
    font-family: system-ui, sans-serif;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  [aria-current] {
    font-weight: bold;
  }
  main {
    padding: 1rem;
    font-family: system-ui, sans-serif;
  }
</style>
