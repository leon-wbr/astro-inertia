---
import { definePage, errorFor } from "astro-inertia";
import ContentElements from "../components/ContentElements.astro";
import Layout from "../layouts/Layout.astro";
import type { SharedProps } from "../types";

// The server validates the form and redirects back to /contact. Validation
// errors arrive in the `errors` prop and a success message as the page's
// flash data, both once, through TYPO3's session. A plain form post sends
// no X-Inertia-Error-Bag header, so the errors aren't scoped to a bag.
const { props, page } = definePage<SharedProps>(Astro);
const action = page.url.split("?")[0];
const nameError = errorFor(props.errors, "name");
const success = typeof page.flash?.success === "string" ? page.flash.success : undefined;
---

<Layout page={page}>
  <ContentElements elements={props.contentElements} />
  {success ? (
    <p role="status">{success}</p>
  ) : (
    <form method="post" action={action}>
      <label>
        Name
        <input name="name" aria-invalid={nameError ? "true" : undefined} />
      </label>
      {nameError && <p role="alert">{nameError}</p>}
      <button type="submit">Send</button>
    </form>
  )}
</Layout>
