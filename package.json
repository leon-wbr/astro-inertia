{
  "name": "astro-inertia-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter astro-inertia build && pnpm --filter './examples/*' build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm --filter astro-inertia test",
    "test:e2e": "pnpm test:e2e:mock && pnpm verify:typo3",
    "test:e2e:mock": "pnpm --filter e2e test:mock",
    "test:e2e:typo3": "pnpm --filter e2e test:typo3",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e",
    "typo3:up": "scripts/typo3.sh up",
    "typo3:down": "scripts/typo3.sh down",
    "verify:typo3": "scripts/verify-typo3.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
