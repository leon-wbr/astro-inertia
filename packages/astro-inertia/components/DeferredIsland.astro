---
/**
 * The server island behind <Deferred>. Its props travel (encrypted) in the
 * island URL, so they stay small: the page URL, component, version, keys
 * and the component names to render.
 */
import { loadDeferredIsland } from "astro-inertia/runtime";

interface Props {
  url: string;
  component: string;
  version: string | null;
  keys: string[];
  render: string;
  error?: string | undefined;
}

const { url, component, version, keys, render, error } = Astro.props;

const result = await loadDeferredIsland(Astro, { page: { url, component, version }, keys, render, error });
const Component = result.Component;
const props = result.kind === "loaded" ? { ...result.page.props, page: result.page } : {};
---

{Component ? <Component {...props} /> : <p data-inertia-deferred-error>Could not load {keys.join(", ")}.</p>}
