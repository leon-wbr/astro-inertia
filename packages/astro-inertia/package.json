{
  "name": "astro-inertia",
  "version": "0.1.1",
  "description": "Render any Inertia v3 server's pages with Astro components, on the server. Works with Laravel or any other Inertia backend. Experimental.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leon-wbr/astro-inertia.git",
    "directory": "packages/astro-inertia"
  },
  "homepage": "https://www.npmjs.com/package/astro-inertia",
  "bugs": "https://github.com/leon-wbr/astro-inertia/issues",
  "type": "module",
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "inertia",
    "inertiajs",
    "laravel",
    "ssr",
    "server-side-rendering"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./route.astro": "./components/route.astro",
    "./Deferred.astro": "./components/Deferred.astro",
    "./InertiaPageData.astro": "./components/InertiaPageData.astro",
    "./components": "./components/index.ts",
    "./DeferredIsland.astro": "./components/DeferredIsland.astro"
  },
  "files": [
    "dist",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "json-schema-to-typescript": "^16.0.0"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "astro": "^7.4.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
